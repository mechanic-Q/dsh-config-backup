# @dsh-ops is absent from npmmirror (the machine-wide registry only carries
# @dsh-ops/bash-win32-x64@0.0.0-stage), but dsh-ops@0.3.0 declares its three
# platform binaries at 0.2.1. Route just this scope to npmjs, where 0.2.1 is the
# `latest` tag and is 168h old (passes the 24h release-age gate).
@dsh-ops:registry=https://registry.npmjs.org/

# billion-context 0.1.201 is on npmjs; npmmirror still serves 0.1.200 as latest.
# (2026-10-18, needed by pnpm add for new plugins.)
billion-context:registry=https://registry.npmjs.org/
